      ],
      "id": "23950ca2-82d6-4c03-839b-159f8a7bf0fd",
      "name": "Telegram Trigger",
      "webhookId": "68bc219b-3e63-47af-af42-6a42736f6ca4",
      "notes": "Select your Telegram credential (BotFather token). Requires a public HTTPS webhook URL."
    },
    {
      "parameters": {
        "jsCode": "// Telegram Task Manager — command parser (no external AI/API dependency).\n// Optional security: put your Telegram numeric user ID between the quotes.\n// Keep empty ('') to allow any Telegram user to message this bot privately.\nconst ALLOWED_TELEGRAM_USER_ID = '';\nconst message = $input.first().json.message || {};\nconst chat_id = String(message.chat?.id ?? '');\nconst user_id = String(message.from?.id ?? '');\nconst normalizeDigits = (s) => String(s).replace(/[۰-۹]/g, x => String(x.charCodeAt(0)-1776)).replace(/[٠-٩]/g, x => String(x.charCodeAt(0)-1632));\nconst raw = String(message.text ?? '').trim();\nconst text = normalizeDigits(raw).replace(/ي/g,'ی').replace(/ك/g,'ک');\nconst help = '🤖 راهنمای مدیریت کارها:\\n\\n➕ افزودن: /add تمرین پایتون\\n➕ با تاریخ: /add تمرین پایتون | 2026-12-01 | 10:30\\n➕ فارسی: فردا تمرین پایتون ساعت ۱۰ صبح\\n📋 کارهای باز: /list\\n📅 کارهای امروز: /today\\n✅ اتمام کار: /done TASK_ID\\n❓ راهنما: /help\\n\\nتاریخ عددی میلادی (YYYY-MM-DD) است. زمان بر اساس ایران نمایش داده می‌شود.';\nfunction iranISODate(offsetDays=0) {\n  const parts = new Intl.DateTimeFormat('en-US',{timeZone:'Asia/Tehran',year:'numeric',month:'2-digit',day:'2-digit'}).formatToParts(new Date());\n  const grab = k => Number(parts.find(p=>p.type===k)?.value ?? 0);\n  const d = new Date(Date.UTC(grab('year'),grab('month')-1,grab('day')+offsetDays));\n  return d.toISOString().slice(0,10);\n}\nfunction validISODate(s) {\n  if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(s)) return false;\n  const d = new Date(s+'T00:00:00Z');\n  return !Number.isNaN(d.getTime()) && d.toISOString().slice(0,10)===s;\n}\nfunction clock(h,m,period='') {\n  h=Number(h);m=Number(m || 0);\n  if (m>59 || h<0 || h>23) return '';\n  if (period) {\n    if (h<1 || h>12) return '';\n    if (period==='صبح' && h===12) h=0;\n    if (period==='ظهر' || period==='عصر' || period==='شب') {\n      if (period==='شب' && h===12) h=0;\n      else if (h<12) h+=12;\n    }\n  }\n  return String(h).padStart(2,'0')+':'+String(m).padStart(2,'0');\n}\nconst basic = {chat_id,user_id,today_ymd:iranISODate(),source_text:raw};\nconst reply = (s) => [{json:{...basic,route:'reply',reply_text:s}}];\nif (!chat_id || !user_id) return [];\nif (message.chat?.type !== 'private') return reply('🔒 این ربات فقط در گفت‌وگوی خصوصی کار می‌کند.');\nif (ALLOWED_TELEGRAM_USER_ID && user_id !== ALLOWED_TELEGRAM_USER_ID) return reply('⛔ این ربات خصوصی است.');\nif (!text || /^\\/(start|help)(?:@\\w+)?\\s*$/i.test(text)) return reply(help);\nif (/^\\/(list|tasks|today)(?:@\\w+)?\\s*$/i.test(text)) return [{json:{...basic,route:'list',only_today:/^\\/today/i.test(text)}}];\nif (/^\\/done(?:@\\w+)?(?:\\s+|$)/i.test(text)) {\n  const task_id = text.replace(/^\\/done(?:@\\w+)?/i,'').trim().toUpperCase();\n  if (!/^T[A-Z0-9]{8,24}$/.test(task_id)) return reply('⚠️ شناسه کار معتبر نیست. نمونه:\\n/done TXXXXXXXXXXXX\\n\\nبرای دیدن شناسه‌ها /list را بفرست.');\n  return [{json:{...basic,route:'done',task_id}}];\n}\nif (/^\\//.test(text) && !/^\\/add(?:@\\w+)?(?:\\s+|$)/i.test(text)) return reply(help);\nlet body = text.replace(/^\\/add(?:@\\w+)?\\s*/i,'').trim();\nif (!body) return reply('⚠️ عنوان کار را وارد کن.\\n\\n'+help);\nlet task=body, due_date='', due_time='';\nif (body.includes('|')) {\n  const fields=body.split('|').map(s=>s.trim());\n  if (fields.length>3) return reply('⚠️ فرمت درست:\\n/add عنوان کار | YYYY-MM-DD | HH:MM');\n  task=fields[0] || '';\n  if (fields[1]) {\n    due_date = fields[1]==='امروز'?iranISODate():fields[1]==='فردا'?iranISODate(1):fields[1];\n    if (!validISODate(due_date)) return reply('⚠️ تاریخ باید میلادی و به شکل YYYY-MM-DD باشد.');\n  }\n  if (fields[2]) {\n    const m=fields[2].match(/^(\\d{1,2}):(\\d{2})$/);\n    if (!m || !(due_time=clock(m[1],m[2]))) return reply('⚠️ زمان باید به شکل 09:30 یا 18:00 باشد.');\n  }\n} else {\n  const rel=task.match(/(?:^|\\s)(امروز|فردا)(?=\\s|$)/);\n  if (rel) {\n    due_date=iranISODate(rel[1]==='فردا'?1:0);\n    task=task.replace(rel[0],' ').trim();\n  }\n  const iso=task.match(/(?:^|\\s)(\\d{4}-\\d{2}-\\d{2})(?=\\s|$)/);\n  if (iso) {\n    if (!validISODate(iso[1])) return reply('⚠️ تاریخ نامعتبر است؛ از YYYY-MM-DD میلادی استفاده کن.');\n    due_date=iso[1];task=task.replace(iso[0],' ').trim();\n  }\n  const tm=task.match(/\\s*ساعت\\s*(\\d{1,2})(?::(\\d{1,2}))?\\s*(صبح|ظهر|عصر|شب)?/);\n  if (tm) {\n    due_time=clock(tm[1],tm[2],tm[3]||'');\n    if (!due_time) return reply('⚠️ ساعت نامعتبر است. نمونه: ساعت ۱۰ صبح یا ساعت 18:30');\n    task=task.replace(tm[0],' ').trim();\n  }\n}\ntask=task.replace(/\\s+/g,' ').trim();\nif (!task || task.length>200) return reply('⚠️ عنوان کار باید بین ۱ تا ۲۰۰ کاراکتر باشد.');\nconst task_id='T'+Date.now().toString(36).toUpperCase()+Math.random().toString(36).slice(2,6).toUpperCase();\nreturn [{json:{...basic,route:'add',Task_ID:task_id,Chat_ID:chat_id,Task:task,Due_Date:due_date,Due_Time:due_time,Status:'Open',Created_At:new Date().toISOString(),Completed_At:'',Source:'Telegram'}}];"
      },
