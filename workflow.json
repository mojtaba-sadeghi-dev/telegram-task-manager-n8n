    {
      "parameters": {
        "jsCode": "const context=$('Parse Telegram Message').first().json;\nconst rows=$input.all().map(i=>i.json||{});\nconst found=rows.find(r=>String(r.Task_ID??'').trim().toUpperCase()===context.task_id && String(r.Chat_ID??'').trim()===context.chat_id);\nif (!found) return [{json:{found_flag:'no',chat_id:context.chat_id,reply_text:'🔎 کاری با این شناسه در فهرست تو پیدا نشد.\\nبرای دیدن کارهای باز /list را بفرست.'}}];\nif (String(found.Status??'').trim().toLowerCase()==='done') return [{json:{found_flag:'no',chat_id:context.chat_id,reply_text:'✅ این کار قبلاً انجام‌شده ثبت شده است.'}}];\nreturn [{json:{found_flag:'yes',Task_ID:context.task_id,Status:'Done',Completed_At:new Date().toISOString(),Task:String(found.Task??''),chat_id:context.chat_id}}];"
      },
