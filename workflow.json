    {
      "parameters": {
        "jsCode": "const context = $('Parse Telegram Message').first().json;\nconst data=$input.all().map(x=>x.json||{});\nlet tasks=data.filter(r=>String(r.Chat_ID??'').trim()===context.chat_id && String(r.Status??'Open').trim().toLowerCase()!=='done');\nif (context.only_today) tasks=tasks.filter(r=>String(r.Due_Date??'').trim()===context.today_ymd);\ntasks.sort((a,b)=>String(a.Due_Date||'9999').localeCompare(String(b.Due_Date||'9999')) || String(a.Due_Time||'99').localeCompare(String(b.Due_Time||'99')) || String(a.Created_At||'').localeCompare(String(b.Created_At||'')));\nconst limit=10;\nconst text=tasks.length===0 ? (context.only_today?'📅 برای امروز کار بازی ثبت نشده است.':'📭 هنوز کار بازی ثبت نشده است.\\n\\nبرای افزودن: /add تمرین پایتون') :\n  (context.only_today?'📅 کارهای باز امروز':'📋 کارهای باز')+' ('+tasks.length+'):\\n\\n'+tasks.slice(0,limit).map((r,i)=>{\n    const title=String(r.Task||'بدون عنوان').slice(0,130);\n    const when=[String(r.Due_Date||'').trim(),String(r.Due_Time||'').trim()].filter(Boolean).join(' ');\n    return (i+1)+'. '+title+(when?'\\n🕒 '+when:'')+'\\n🆔 '+String(r.Task_ID||'');\n  }).join('\\n\\n')+(tasks.length>limit?'\\n\\n... و '+(tasks.length-limit)+' مورد دیگر':'')+'\\n\\nبرای انجام‌شده کردن: /done TASK_ID';\nreturn [{json:{chat_id:context.chat_id,reply_text:text}}];"
      },
